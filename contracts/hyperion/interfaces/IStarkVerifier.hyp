pragma hyperion >=0.0;

/// @title IStarkVerifier
/// @notice Minimal verifier surface shared by every QuantaStark STARK verifier.
/// @dev `proof` is the packed calldata layout described in docs/PROTOCOL.md
///      (8-byte little-endian Goldilocks elements, 32-byte digests).
///      `publicValues` holds the AIR's public inputs in the same element encoding.
///      Implementations revert with a custom error on any malformed or failing
///      proof and return true on success. QuantaStark verifiers never return
///      false; the boolean exists so callers can treat a non-reverting call
///      as accepted without decoding revert data.
interface IStarkVerifier {
    /// @notice Identifier of the AIR, proof protocol, parameters and public-value schema.
    function programIdentifier() external view returns (bytes32);

    /// @notice Exact public-value byte length accepted by this verifier.
    /// @dev Consumers use this to reject an AIR whose statement encoding is
    ///      incompatible with their own before any facts can be registered.
    function publicValuesLength() external view returns (uint512);

    function verify(bytes calldata proof, bytes calldata publicValues) external view returns (bool);
}
