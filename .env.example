# Copy to .env (ignored). Never put a private seed in a tracked file or in shell history.

# Deployer for networks other than the gqrl dev node: a 34-word ML-DSA-87 mnemonic
# or a 102-character extended-seed hex value. Leave empty on the local networks and
# select a published Kurtosis fixture per command with STARK_PUBLIC_DEV_ACCOUNT=0 instead.
TESTNET_SEED=

# JSON-RPC endpoint for the chain-bound test suites (test/contracts). Unset = suites skip.
# Dev node: http://127.0.0.1:8545 (chain 1337). Kurtosis: http://127.0.0.1:32102 (chain 3151909).
STARK_RPC_URL=

# Deployment record read by deploy, verify:proof and gas:report.
# config/dev-node.json or config/local-stark.json (both ignored, seeded from the .example.json files).
STARK_CONFIG=

# 64-byte Hyperion compiler. The system hypc predates the 64-byte word and must never be used.
HYPERION_COMPILER=../hyperion-stark/build/hypc/hypc
